#!/bin/bash
# lab02 start values, us-west-2: source env.test-usw2.export && ./lab02.sh launch
export AWS_PROFILE="<aws-profile>"
export AWS_REGION="us-west-2"

# public subnets per AZ; AZ name <-> AZ id mapping is per account
export SUBNET_MAP="us-west-2a=<subnet-id-2a> us-west-2b=<subnet-id-2b> us-west-2c=<subnet-id-2c> us-west-2d=<subnet-id-2d>"
export LAUNCH_AZS="us-west-2a us-west-2b us-west-2c us-west-2d"   # try order
export SUBNET_ID=""
export LAUNCH_ROUNDS="3"
export LAUNCH_RETRY_DELAY_S="30"

export SECURITY_GROUP_ID="<sg-id>"                      # egress only
export IAM_INSTANCE_PROFILE="<instance-profile-name>"   # S3 on bucket + AmazonSSMManagedInstanceCore
export KEY_NAME=""

# export INSTANCE_TYPE="g7e.8xlarge"                    # 1x RTX PRO 6000 96 GiB, 1.9 TB NVMe
export INSTANCE_TYPE="g6e.8xlarge"                      # 1x L40S 48 GiB, 2x NVMe 900 GB (RAID0)
export MAX_SPOT_PRICE="2.50"                            # $/h cap; above it = skipped / interrupted

export S3_BUCKET="<bucket-usw2>"
export AMI_ID=""                                        # empty = base AL2023 (bake flow)

# --- serving: qwen3.8:27b (dense 27B, 17 GB), ~23 tok/s total on L4, 2 slots max useful ---
# export MODELS="qwen3.8:27b"
# export OLLAMA_CONTEXT_LENGTH="32768"
# export OLLAMA_NUM_PARALLEL="2"
# export OLLAMA_FLASH_ATTENTION="1"
# export OLLAMA_KV_CACHE_TYPE="q8_0"
# export OLLAMA_MAX_LOADED_MODELS="1"
# --- serving: gpt-oss:20b (MoE 21B / 3.6B active, 14 GB), parallel-friendly ---
export MODELS="gpt-oss:20b"
export OLLAMA_CONTEXT_LENGTH="32768"                    # small KV (SWA + GQA)
export OLLAMA_NUM_PARALLEL="6"                          # 6 x 32K -> 17.1 GB VRAM on L4
export OLLAMA_FLASH_ATTENTION="1"
export OLLAMA_KV_CACHE_TYPE=""
export OLLAMA_MAX_LOADED_MODELS="1"
