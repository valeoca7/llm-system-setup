#!/bin/bash
# lab02 start values, eu-north-1: source env.test-eun1.export && ./lab02.sh spot-price && ./lab02.sh launch
export AWS_PROFILE="<aws-profile>"
export AWS_REGION="eu-north-1"

# 1a: g6, g6e, g7e | 1b: g6, g6e, g5 | 1c: g7e, g5; AZs without the type are skipped
export SUBNET_MAP="eu-north-1a=<subnet-id-1a> eu-north-1b=<subnet-id-1b> eu-north-1c=<subnet-id-1c>"
export LAUNCH_AZS="eu-north-1a eu-north-1b eu-north-1c"
export SUBNET_ID=""
export LAUNCH_ROUNDS="3"
export LAUNCH_RETRY_DELAY_S="30"

export SECURITY_GROUP_ID="<sg-id>"                      # egress only; empty = look up SECURITY_GROUP_NAME
export IAM_INSTANCE_PROFILE="<instance-profile-name>"
export KEY_NAME=""

# export INSTANCE_TYPE="g6.2xlarge"                     # 1x L4 24 GiB, 450 GB NVMe
# export INSTANCE_TYPE="g7e.8xlarge"                    # 1x RTX PRO 6000 96 GiB, 1.9 TB
export INSTANCE_TYPE="g7e.2xlarge"
# export INSTANCE_TYPE="g6e.8xlarge"                    # 1x L40S 48 GiB, 32 vCPU, 256 GiB, 900 GB NVMe
# export INSTANCE_TYPE="g6e.4xlarge"                    # 1x L40S 48 GiB, 16 vCPU, 128 GiB, 600 GB NVMe
# export INSTANCE_TYPE="g6.4xlarge"                     # 1x L4 24 GiB, 16 vCPU, 64 GiB, 600 GB NVMe
export MAX_SPOT_PRICE="2.50"

export S3_BUCKET="<bucket-eun1>"                        # same region as the host
export AMI_ID=""                                        # set after ./lab02.sh bake

# --- serving: qwen3.8:27b (dense 27B, 17 GB), ~23 tok/s total on L4, 2 slots max useful ---
# export MODELS="qwen3.8:27b"
# export OLLAMA_CONTEXT_LENGTH="32768"
# export OLLAMA_NUM_PARALLEL="2"
# export OLLAMA_FLASH_ATTENTION="1"
# export OLLAMA_KV_CACHE_TYPE="q8_0"
# export OLLAMA_MAX_LOADED_MODELS="1"
# --- serving: gpt-oss:20b (MoE 21B / 3.6B active, 14 GB), parallel-friendly ---
export MODELS="gpt-oss:20b"
export OLLAMA_CONTEXT_LENGTH="32768"                    # small KV (SWA + GQA)
export OLLAMA_NUM_PARALLEL="6"                          # 6 x 32K -> 17.1 GB VRAM on L4
export OLLAMA_FLASH_ATTENTION="1"
export OLLAMA_KV_CACHE_TYPE=""
export OLLAMA_MAX_LOADED_MODELS="1"
